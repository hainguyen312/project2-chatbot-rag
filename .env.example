# Sao chép thành .env rồi điền giá trị. Không commit .env.

# ── LLM / embedding ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini           # rewrite, intent, memory, sinh câu known-item
OPENAI_AGENT_MODEL=gpt-4.1         # agent trả lời (tool-calling)
ANTHROPIC_API_KEY=                 # chỉ cho eval (Claude làm judge)

# ── Truy hồi ─────────────────────────────────────────────────────
RRF_W_VECTOR=0.5                   # vector_weight: trọng số Milvus (tên điều) trong RRF; BM25 cố định 1.0

# ── Web search ───────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── MongoDB (lịch sử chat, memory, semantic cache) ───────────────
MONGODB_URI=
MONGODB_DB=chatbot_rag
MONGODB_COLLECTION=conversations

# ── MySQL / Neo4j / Milvus (mặc định khớp docker-compose local) ──
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=123456789
# MYSQL_DATABASE=law
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password123
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
