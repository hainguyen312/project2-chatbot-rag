# Mẫu .env.prod — sao chép thành .env.prod (gốc repo), điền giá trị, chmod 600.
# .env.prod đã được gitignore (.env.*). KHÔNG commit, KHÔNG dán vào chat.
#
# Dùng:  docker compose -f docker-compose.prod.yml --env-file .env.prod …
# Kiểm thiếu biến (không in giá trị):
#        docker compose -f docker-compose.prod.yml --env-file .env.prod config --quiet
#
# Mật khẩu mới, dài, ngẫu nhiên — KHÔNG dùng lại 123456789 / password123 / minioadmin
# (coi như đã lộ, SURVEY mục 9). Tạo nhanh:  openssl rand -base64 33 | tr -d '/+='

# ── Cloudflare Tunnel (đã có) ────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Mật khẩu dịch vụ nội bộ (tạo mới) ────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# MYSQL_USER=law_app          # mặc định
# MYSQL_DATABASE=law          # mặc định
NEO4J_PASSWORD=
MINIO_ROOT_USER=milvus
MINIO_ROOT_PASSWORD=

# ── Lấy từ .env (bản dev ở gốc repo) ─────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_AGENT_MODEL=
TAVILY_API_KEY=
MONGODB_URI=
MONGODB_DB=
MONGODB_COLLECTION=
# FIREBASE_STORAGE_BUCKET=    # bỏ trống → suy ra <project_id>.firebasestorage.app

# ── Lấy từ frontend/.env.local (nhúng vào bundle lúc build — cấu hình web công khai) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_OFFICE_DATA=live

# ── Build / deploy ───────────────────────────────────────────────────────────
# IMAGE_TAG=local             # deploy.sh đặt = git sha
# TORCH_VARIANT=cu128         # cpu nếu máy không có GPU
# FIREBASE_CRED_GID=1001      # gid nhóm sở hữu firebase-credentials.json (mode 640)
# FIREBASE_CRED_FILE=./firebase-credentials.json   # deploy.sh tự đặt đường dẫn tuyệt đối

# ── Tuỳ chọn backend (bỏ trống/không khai báo → mặc định trong code) ─────────
# DAILY_QUESTION_CAP=300      # trần câu hỏi/ngày toàn hệ thống (chat + rà soát); 0 = tạm dừng LLM
# SENTIMENT_DEVICE=auto       # auto | cuda | cpu
# SSE_HEARTBEAT_SECONDS=15
# HEALTH_TIMEOUT_SECONDS=3
# Các biến tinh chỉnh khác (MEMORY_*, AGENT_*, CACHE_*, DOC_REVIEW_*, GRAPH_W_*, …): xem danh
# sách trong docker-compose.prod.yml, service backend. Không cần cho prod: ES_*, ANTHROPIC_API_KEY.
