@startuml UC14_SEQ
!include ../_style.iuml
title Biểu đồ tuần tự UC14 — Xây dựng đồ thị tri thức
autonumber
actor "Quản trị viên" as A
participant "build_graph" as G
participant "legal_graph" as P
database "MySQL" as DB
database "Neo4j" as N
A -> G : python -m retrieve.build_graph
G -> N : CREATE CONSTRAINT / INDEX
G -> DB : đọc pdchude, pddemuc, pdchuong
G -> N : MERGE nút + CO_DE_MUC, CO_CHUONG
G -> DB : đọc pddieu
G -> P : parse_vbqppl, split_khoan
loop mỗi lô
  G -> N : MERGE Dieu + CO_DIEU, Khoan + CO_KHOAN
end
G -> N : MERGE VanBan, THUOC, DUOC_SUA_DOI_BOI
G -> DB : đọc pdmuclienquan
G -> N : MERGE LIEN_QUAN (hai chiều)
G -> P : extract_references, resolve_reference
G -> N : MERGE THAM_CHIEU (khoản, điểm, ngữ cảnh ngoại lệ)
G --> A : hoàn tất
@enduml
