  usecase "Tìm hội thoại" as F
  usecase "Mở hội thoại" as O
  usecase "Tạo hội thoại mới" as N
  usecase "Đổi tên" as RN
  usecase "Ghim / bỏ ghim" as P
  usecase "Xoá" as D
  usecase "Đặt tên tự động" as T
}
U --> L
U --> N
F .> L : <<extend>>
O .> L : <<extend>>
RN .> L : <<extend>>
P .> L : <<extend>>
