@startuml UC13_ACT
!include ../_style.iuml
title Biểu đồ hoạt động UC13 — Lập chỉ mục vector và BM25
|Quản trị viên|
start
:Chạy seed_data_batch.py;
|seed_data_batch|
repeat :Lấy lô 200 điều;
  if (Nhúng cả lô thành công?) then (có)
    :Ghi Milvus;
  else (không)
    :Nhúng từng điều,\nghi điều lỗi vào embed_errors.csv;
  endif
repeat while (Còn điều?) is (còn) not (hết)
|Máy chủ dịch vụ|
:Khởi động: nạp chỉ mục BM25 từ đĩa;
if (Có bộ đệm đúng phiên bản?) then (có)
  :Dùng chỉ mục đã lưu;
else (không)
  :Tách từ, tách điều dài theo nhóm khoản,\nxây BM25, lưu đĩa;
endif
stop
@enduml
