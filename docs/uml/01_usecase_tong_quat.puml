Member -|> Guest

rectangle "Hệ thống hỏi đáp pháp luật" {
  rectangle "Hỏi đáp" as G1 {
    usecase "UC01. Hỏi đáp pháp luật" as UC01
    usecase "UC02. Phân tích tình huống" as UC02
    usecase "UC03. Xem điều luật trích dẫn" as UC03
    usecase "UC04. Hỏi bằng giọng nói" as UC04
    usecase "UC05. Nghe câu trả lời" as UC05
    usecase "UC06. Đánh giá câu trả lời" as UC06
    usecase "UC09. Văn phòng luật 3D" as UC09
  }
  rectangle "Rà soát văn bản" as G2 {
    usecase "UC16. Rà soát văn bản pháp lý" as UC16
    usecase "UC17. Quản lý lịch sử rà soát" as UC17
  }
  rectangle "Tài khoản và cá nhân hoá" as G3 {
    usecase "UC07. Quản lý hội thoại" as UC07
    usecase "UC08. Quản lý bộ nhớ cá nhân" as UC08
    usecase "UC10. Đăng ký / Đăng nhập" as UC10
    usecase "UC11. Đăng xuất" as UC11
  }
  rectangle "Quản trị" as G4 {
    usecase "UC12. Thu thập dữ liệu Pháp Điển" as UC12
    usecase "UC13. Lập chỉ mục vector và BM25" as UC13
    usecase "UC14. Xây dựng đồ thị tri thức" as UC14
    usecase "UC15. Đánh giá chất lượng" as UC15
    usecase "UC18. Cập nhật văn bản mới" as UC18
    usecase "UC19. Quản lý hiệu lực văn bản" as UC19
  }
}

